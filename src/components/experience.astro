---
import Entry from "./experience/entry.astro";
---

<main class="flex flex-col mx-auto max-w-200 mb-16"> 
  <h3 class="text-3xl font-bold mx-auto mb-10"> Experience </h3>

  <Entry 
    date={['Apr 2025']} 
    team="Local Bar website (Lloret de Mar/Girona)"
    description={`
      Next.js landing page optimized for local 
      SEO and Google ranking. Built to capture 
      organic traffic and seamlessly redirect 
      users to the bar's Instagram, centralizing 
      customer contact and digital visibility.
    `}
  />

  <Entry 
    date={['Aug 2025', 'Dec 2025']} 
    team="Manivis"
    description={`
      Development of web applications using NextJs and 
      Express frameworks. Full stack work, multimedia 
      management, and process optimization.
    `}
  />

  <Entry 
    date={['Oct 2024', 'Jun 2025']} 
    team="CS Teacher Assistant"
    description={`
      Training students for algorithmic competitions. 
      Developing platforms for practicing coding. 
      Analyzing algorithms and data structures.
    `}
  />
  <Entry 
    date={['Sept 2021', 'Apr 2024']} 
    team="Student"
    description={`
      Get started with dozens of web components and 
      interactive elements built on top of Tailwind CSS. 
      I combined my high school studies with programming 
      studies, delving deeper into the study of 
      algorithms, data structures, computational 
      complexity, and dynamic programming. During this 
