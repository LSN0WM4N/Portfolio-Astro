---
import { getCollection } from "astro:content"
import Card from "./projects/card.astro";

const projects = await getCollection('projects');
---

<main class="flex flex-col max-w-200 mx-auto gap-8">
  <h3 class="text-3xl font-bold mx-auto">Projects</h3>


  { projects.map(p => ( 
    <Card 
      { ...p.data }
      featured={ false }
    />
  )) }
</main>

